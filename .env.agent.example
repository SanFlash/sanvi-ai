# Optional hosted bridge
SANVI_SERVER_URL=https://YOUR-RENDER-SERVICE.onrender.com
SANVI_AGENT_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Local voice
SANVI_VOICE_LANGUAGE=en-IN

# Set true only if you want voice/remote SANVI to execute shutdown/restart/delete automatically.
# Keep false/empty to require explicit confirmation for destructive actions.
SANVI_ALLOW_AUTOMATIC_DANGEROUS=false

# Optional explicit Android ADB path. Leave empty when adb is on PATH.
ANDROID_ADB=
