# SANVI local-first configuration

# Hosted bridge (optional)
SANVI_SERVER_URL=https://sanvi-ai.onrender.com
SANVI_AGENT_TOKEN=

# Voice
SANVI_VOICE_LANGUAGE=en-IN

# Safety
# Keep false. Use explicit "confirm ..." commands for privileged/destructive actions.
SANVI_ALLOW_AUTOMATIC_DANGEROUS=false

# Optional Android ADB path
ANDROID_ADB=

# AI planner
SANVI_AI_PROVIDER=openai
SANVI_AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Local AI alternative
# SANVI_AI_PROVIDER=ollama
# SANVI_AI_MODEL=llama3.2-vision
# SANVI_OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Optional logging
LOG_LEVEL=INFO
